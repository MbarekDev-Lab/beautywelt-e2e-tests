{
  "name": "beautywelt-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Production-safe Playwright TypeScript test framework for Beautywelt production and authorized Haarpflege staging environments.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "test": "npm run verify",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:list",
    "verify:production": "npm run verify && npm run test:production",
    "verify:staging": "npm run verify:staging:static && npm run test:staging",
    "verify:staging:static": "npm run format:check && npm run lint && npm run typecheck && npm run test:list:staging",
    "test:test-domain": "npm run test:test-domain:auth && npm run test:test-domain:desktop:run && npm run test:test-domain:mobile:run",
    "test:test-domain:auth": "cross-env ENV_FILE=.env.staging playwright test --project=staging-auth",
    "test:test-domain:desktop": "npm run test:test-domain:auth && npm run test:test-domain:desktop:run",
    "test:test-domain:desktop:run": "cross-env ENV_FILE=.env.staging playwright test --project=staging-desktop --grep-invert @destructive",
    "test:test-domain:destructive": "cross-env ENV_FILE=.env.staging RUN_DESTRUCTIVE_TESTS=true playwright test --project=staging-desktop --grep @destructive",
    "test:test-domain:mobile": "npm run test:test-domain:auth && npm run test:test-domain:mobile:run",
    "test:test-domain:mobile:run": "cross-env ENV_FILE=.env.staging playwright test --project=staging-mobile",
    "test:test-domain:desktop:ui": "cross-env ENV_FILE=.env.staging playwright test --project=staging-desktop --ui",
    "test:test-domain:mobile:ui": "cross-env ENV_FILE=.env.staging playwright test --project=staging-mobile --ui",
    "test:test-domain:list": "cross-env ENV_FILE=.env.staging playwright test --list --project=staging-auth --project=staging-desktop --project=staging-mobile",
    "test:list": "cross-env ENV_FILE=.env.prod playwright test --list",
    "test:list:production": "cross-env ENV_FILE=.env.prod playwright test --list --project=production-readonly",
    "test:list:test-domain": "cross-env ENV_FILE=.env.staging playwright test --list --project=staging-auth --project=staging-desktop --project=staging-mobile",
    "test:list:offline": "playwright test --list --project=offline",
    "test:list:unit": "playwright test --list --project=unit",
    "test:production": "cross-env ENV_FILE=.env.prod playwright test --project=production-readonly",
    "test:production:headed": "cross-env ENV_FILE=.env.prod playwright test --project=production-readonly --headed",
    "test:production:ui": "cross-env ENV_FILE=.env.prod playwright test --project=production-readonly --ui",
    "test:staging": "npm run test:staging:auth && npm run test:staging:desktop:run && npm run test:staging:mobile:run",
    "test:staging:auth": "cross-env ENV_FILE=.env.staging playwright test --project=staging-auth",
    "test:staging:desktop": "npm run test:staging:auth && npm run test:staging:desktop:run",
    "test:staging:desktop:run": "cross-env ENV_FILE=.env.staging playwright test --project=staging-desktop",
    "test:staging:mobile": "npm run test:staging:auth && npm run test:staging:mobile:run",
    "test:staging:mobile:run": "cross-env ENV_FILE=.env.staging playwright test --project=staging-mobile",
    "test:staging:desktop:headed": "cross-env ENV_FILE=.env.staging playwright test --project=staging-desktop --headed",
    "test:staging:desktop:ui": "cross-env ENV_FILE=.env.staging playwright test --project=staging-desktop --ui",
    "test:staging:mobile:headed": "cross-env ENV_FILE=.env.staging playwright test --project=staging-mobile --headed",
    "test:staging:mobile:ui": "cross-env ENV_FILE=.env.staging playwright test --project=staging-mobile --ui",
    "test:staging:navigation:desktop": "npm run test:staging:auth && cross-env ENV_FILE=.env.staging playwright test tests/staging/desktop/navigation.spec.ts --project=staging-desktop",
    "test:staging:navigation:desktop:ui": "cross-env ENV_FILE=.env.staging playwright test tests/staging/desktop/navigation.spec.ts --project=staging-desktop --ui",
    "test:staging:navigation:mobile": "npm run test:staging:auth && cross-env ENV_FILE=.env.staging playwright test tests/staging/mobile/navigation.spec.ts --project=staging-mobile",
    "test:staging:navigation:mobile:ui": "cross-env ENV_FILE=.env.staging playwright test tests/staging/mobile/navigation.spec.ts --project=staging-mobile --ui",
    "test:offline": "cross-env ENV_FILE=.env.prod playwright test --project=offline",
    "test:unit": "cross-env ENV_FILE=.env.prod playwright test --project=unit",
    "test:safe": "npm run test:unit && npm run test:offline",
    "lint": "eslint \"{tests,pages,components,fixtures,config,utils,test-data,api}/**/*.ts\" \"*.ts\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"{tests,pages,components,fixtures,config,utils,test-data,api}/**/*.ts\" \"*.ts\" --fix --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "clean": "rimraf playwright-report test-results blob-report reports coverage screenshots",
    "install:browsers": "playwright install",
    "install:browsers:ci": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.19.43",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  }
}
