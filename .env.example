# ==============================================================================
# Beautywelt E2E Test Environment Configuration — EXAMPLE TEMPLATE
# ==============================================================================
# Copy this file to .env.staging or .env.prod and fill in real values.
# NEVER commit .env.staging or .env.prod to version control.
#
# Usage:
#   cp .env.example .env.staging   # then fill in staging credentials
#   cp .env.example .env.prod      # then fill in production settings
# ==============================================================================

# ---------------------------------------------------------------------------
# Core environment settings
# ---------------------------------------------------------------------------
# The base URL of the target environment (must be HTTPS)
BASE_URL=

# One of: production | staging | offline | unit
TARGET_ENV=

# Set to 'true' only for staging environments that run state-changing tests
ALLOW_STATE_CHANGES=false

# A reference token that authorises state-changing tests on the staging domain.
# Required when TARGET_ENV=staging and ALLOW_STATE_CHANGES=true
TEST_AUTHORIZATION_REFERENCE=

# ---------------------------------------------------------------------------
# Rate / budget controls
# ---------------------------------------------------------------------------
# Maximum number of individual test cases allowed to run against production
PRODUCTION_TEST_BUDGET=10

# Maximum number of page navigations allowed during a production test run
PRODUCTION_NAVIGATION_BUDGET=10

# ---------------------------------------------------------------------------
# HTTP Basic Authentication (staging only)
# ---------------------------------------------------------------------------
# Username and password for HTTP Basic Auth on the staging server.
# Required when TARGET_ENV=staging.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# Staging test data
# ---------------------------------------------------------------------------
# Product search term and expected product name used in staging smoke tests
STAGING_SEARCH_TERM=
STAGING_PRODUCT_NAME=

# ---------------------------------------------------------------------------
# Customer account credentials (optional — login tests)
# ---------------------------------------------------------------------------
# If left blank, tests that require an authenticated customer session are skipped.
VALID_USER_EMAIL=
VALID_USER_PASSWORD=
