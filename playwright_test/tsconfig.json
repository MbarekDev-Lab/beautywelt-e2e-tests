{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    "tests/**/*",
    "pages/**/*",
    "components/**/*",
    "fixtures/**/*",
    "config/**/*",
    "utils/**/*",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
